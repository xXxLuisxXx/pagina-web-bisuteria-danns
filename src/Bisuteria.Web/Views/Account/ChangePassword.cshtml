@model ChangePasswordViewModel
<div class="container py-5">
    <h1>Cambiar contraseña</h1>
    <form method="post" asp-action="ChangePassword" class="col-md-6">
        <div asp-validation-summary="All" class="text-danger"></div>
        <label asp-for="CurrentPassword">Contraseña actual</label>
        <input asp-for="CurrentPassword" class="form-control mb-3" autocomplete="current-password" />
        <label asp-for="Password">Nueva contraseña</label>
        <input asp-for="Password" class="form-control mb-3" autocomplete="new-password" />
        <label asp-for="ConfirmPassword">Confirmar nueva contraseña</label>
        <input asp-for="ConfirmPassword" class="form-control mb-3" autocomplete="new-password" />
        <button class="btn btn-brand" type="submit">Cambiar contraseña</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
