@model TwoFactorViewModel
@{ ViewData["Title"] = "Verificación en dos pasos"; }
<div class="container py-5">
    <h1>Verificación en dos pasos</h1>
    <p>Introduce el código de tu aplicación autenticadora o usa un código de recuperación guardado.</p>
    <form asp-action="TwoFactor" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input asp-for="ReturnUrl" type="hidden" /><input asp-for="RememberMe" type="hidden" />
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" autocomplete="one-time-code" />
        <div class="form-check my-3"><input asp-for="Recovery" class="form-check-input" /><label asp-for="Recovery">Estoy usando un código de recuperación</label></div>
        <button class="btn btn-brand" type="submit">Verificar</button>
    </form>
</div>
