@model AuthenticatorViewModel
@{ ViewData["Title"] = "Seguridad en dos pasos"; }
<div class="container py-5">
    <h1>Seguridad en dos pasos</h1>
    <p>@(Model.RequiresTwoFactor ? "Esta cuenta necesita verificación en dos pasos para acceder a los paneles." : "Puedes activar la verificación en dos pasos para proteger tu cuenta.")</p>
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    @if (Model.Enabled)
    {
        <p class="alert alert-success">Verificación en dos pasos activada.</p>
        @if (Model.RecoveryCodes is not null)
        {
            <p>Guarda estos códigos fuera de este dispositivo. Se muestran una sola vez y cada uno sirve para un acceso si pierdes tu autenticador.</p>
            <ul>@foreach (var code in Model.RecoveryCodes) { <li><code>@code</code></li> }</ul>
        }
        @if (!Model.RequiresTwoFactor)
        {
        <form asp-action="Authenticator" method="post" class="mt-3">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <input type="hidden" name="DisableTwoFactor" value="true" />
            <label asp-for="Password" class="form-label">Confirma tu contraseña para desactivar</label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
            <button class="btn btn-outline-danger mt-3" type="submit">Desactivar verificación en dos pasos</button>
        </form>
        }
    }
    else
    {
        @if (!Model.CanEnableTwoFactor)
        {
            <p class="alert alert-info">La configuración de verificación no está disponible.</p>
        }
        else
        {
            <p>Confirma tu contraseña para obtener una clave. Añádela manualmente a tu aplicación autenticadora como clave temporal (TOTP) de Bisuterías Dann’s.</p>
            @if (Model.SharedKey is not null) { <p>Clave privada: <code>@Model.SharedKey</code></p><p>Después introduce el código de seis dígitos y confirma de nuevo tu contraseña.</p> }
            <form asp-action="Authenticator" method="post">
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                <label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" />
                <label asp-for="Code" class="form-label mt-3"></label><input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" />
                <button class="btn btn-brand mt-3" type="submit">@(Model.SharedKey is null ? "Preparar autenticador" : "Activar verificación")</button>
            </form>
        }
    }
    <a asp-action="Profile" class="btn btn-outline-brand mt-3">Volver al perfil</a>
</div>
