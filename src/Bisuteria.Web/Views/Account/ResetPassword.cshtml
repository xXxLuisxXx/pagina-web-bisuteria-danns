@model ResetPasswordViewModel

<section class="auth-section">
    <div class="container">
        <div class="auth-card mx-auto shadow-sm">
            <div class="text-center mb-4"><span class="eyebrow">Nueva contraseña</span><h2>Restablecer contraseña</h2></div>
            <form asp-action="ResetPassword" method="post">
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="All" role="alert" class="text-danger mb-3"></div>
                <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger small"></span></div>
                <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
                <button class="btn btn-brand w-100" type="submit">Guardar nueva contraseña</button>
            </form>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
