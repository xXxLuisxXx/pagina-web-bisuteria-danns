@model LoginViewModel

<section class="auth-section">
    <div class="container">
        <div class="auth-card mx-auto shadow-sm">
            <div class="text-center mb-4">
                <span class="eyebrow">Bienvenido de nuevo</span>
                <h2>Iniciar sesión</h2>
                <p class="text-muted">Accede a tu cuenta para seguir tus pedidos y favoritos.</p>
            </div>

            @await Html.PartialAsync("_Alerts")

            @if (ViewBag.ReauthenticationRequired == true)
            {
                <div class="alert alert-warning" role="status">
                    Confirma tu identidad para continuar con esta acción. Al volver al panel, tendrás que repetir el envío del formulario.
                </div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="All" role="alert" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Recuérdame</label>
                </div>
                <button class="btn btn-brand w-100 btn-lg" type="submit"><i class="bi bi-box-arrow-in-right me-2"></i>Entrar</button>
            </form>

            <p class="text-center mt-3 mb-0"><a class="text-gold fw-semibold" asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a></p>
            <p class="text-center mt-3 mb-0">
                ¿No tienes cuenta? <a class="text-gold fw-semibold" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Regístrate gratis</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
