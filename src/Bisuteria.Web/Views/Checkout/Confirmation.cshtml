@model OrderDto

<section class="container py-5">
    <div class="text-center mb-5">
        <div class="success-check"><i class="bi bi-check2"></i></div>
        <h1 class="mt-3">¡Gracias por tu compra!</h1>
        <p class="lead text-muted">Tu pedido ha sido recibido y está siendo preparado con mucho amor.</p>
        <div class="order-number-badge">Número de pedido: <strong>@Model.OrderNumber</strong></div>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
            <div class="card card-body shadow-sm mb-4">
                <h5 class="mb-3"><i class="bi bi-box-seam me-2 text-gold"></i>Detalle del pedido</h5>
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex gap-3 mb-3 align-items-center">
                        <div class="checkout-thumb"><img src="@(item.ImageUrl ?? "/img/placeholder.svg")" alt="@item.ProductName"></div>
                        <div class="flex-grow-1">
                            <div>@item.ProductName <span class="text-muted">x @item.Quantity</span></div>
                            @if (!string.IsNullOrWhiteSpace(item.CustomizationSummary))
                            {
                                <div class="text-gold small"><i class="bi bi-magic"></i> @item.CustomizationSummary</div>
                            }
                        </div>
                        <strong>@item.LineTotal.ToString("C")</strong>
                    </div>
                }
            </div>

            <div class="card card-body shadow-sm mb-4">
                <h5 class="mb-3"><i class="bi bi-geo-alt me-2 text-gold"></i>Envío a</h5>
                <p class="mb-1">@Model.CustomerName · @Model.CustomerPhone</p>
                <p class="mb-1">@Model.AddressLine1, @Model.City, @Model.Province</p>
                        @if (!string.IsNullOrWhiteSpace(Model.AddressLine2))
                        {
                            <p class="mb-1"><strong>Dirección complementaria:</strong> @Model.AddressLine2</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.PostalCode))
                        {
                            <p class="mb-1"><strong>Código postal:</strong> @Model.PostalCode</p>
                        }
                <p class="small text-muted mb-0">@Model.PaymentMethodLabel</p>
            </div>

            <div class="text-center">
                <a class="btn btn-outline-brand" asp-controller="Order" asp-action="Index"><i class="bi bi-receipt me-2"></i>Ver mis pedidos</a>
                <a class="btn btn-brand" asp-controller="Catalog" asp-action="Index">Seguir comprando</a>
            </div>
        </div>
    </div>
</section>
