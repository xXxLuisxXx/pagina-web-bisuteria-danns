@model OrderDto
@{
    var paymentProofs = ViewBag.PaymentProofs as IReadOnlyList<PaymentProofDto> ?? Array.Empty<PaymentProofDto>();
}

<section class="container py-5">
    <div class="text-center mb-5">
        <div class="success-check"><i class="bi bi-check2"></i></div>
        <h1 class="mt-3">¡Gracias por tu compra!</h1>
        <p class="lead text-muted">Tu pedido fue recibido. La tienda revisará los datos y coordinará el siguiente paso contigo.</p>
        <div class="order-number-badge">Número de pedido: <strong>@Model.OrderNumber</strong></div>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
            <div class="card card-body shadow-sm mb-4">
                <h5 class="mb-3"><i class="bi bi-box-seam me-2 text-gold"></i>Detalle del pedido</h5>
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex gap-3 mb-3 align-items-center">
                        <div class="checkout-thumb"><img src="@(item.ImageUrl ?? "/img/placeholder.svg")" alt="@item.ProductName"></div>
                        <div class="flex-grow-1">
                            <div>@item.ProductName <span class="text-muted">x @item.Quantity</span></div>
                            @if (!string.IsNullOrWhiteSpace(item.CustomizationSummary))
                            {
                                <div class="text-gold small"><i class="bi bi-magic"></i> @item.CustomizationSummary</div>
                            }
                        </div>
                        <strong>@item.LineTotal.ToString("C")</strong>
                    </div>
                }
            </div>

            <div class="card card-body shadow-sm mb-4">
                <h5 class="mb-3"><i class="bi bi-geo-alt me-2 text-gold"></i>Envío a</h5>
                <p class="mb-1">@Model.CustomerName · @Model.CustomerPhone</p>
                @if (Model.DeliveryMethod == DeliveryMethod.Pickup)
                {
                    <p class="mb-1">Retiro en tienda: la dirección se coordinará directamente.</p>
                }
                else
                {
                    <p class="mb-1">@Model.AddressLine1, @Model.City, @Model.Province</p>
                }
                        @if (!string.IsNullOrWhiteSpace(Model.AddressLine2))
                        {
                            <p class="mb-1"><strong>Dirección complementaria:</strong> @Model.AddressLine2</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.PostalCode))
                        {
                            <p class="mb-1"><strong>Código postal:</strong> @Model.PostalCode</p>
                        }
                <p class="small text-muted mb-0">@Model.PaymentMethodLabel</p>
            </div>

            <div class="card card-body shadow-sm mb-4">
                <h5 class="mb-3">Resumen de pago</h5>
                <p class="mb-1">Subtotal: <strong>@Model.Subtotal.ToString("C")</strong></p>
                @if (Model.Discount > 0) { <p class="mb-1">Descuento: <strong>-@Model.Discount.ToString("C")</strong></p> }
                <p class="mb-1">Envío: <strong>@(Model.ShippingToConfirm ? "Por confirmar con la tienda" : Model.ShippingCost.ToString("C"))</strong></p>
                <p class="mb-0">@(Model.ShippingToConfirm ? "Total parcial; falta confirmar el recargo." : "Total:") <strong>@(Model.ShippingToConfirm ? (Model.Subtotal - Model.Discount).ToString("C") : Model.Total.ToString("C"))</strong></p>
            </div>

            @if (Model.PaymentMethod == PaymentMethod.BankTransfer)
            {
                var bank = ViewBag.BankDetails as Dictionary<string, string> ?? new();
                <div class="card card-body shadow-sm mb-4">
                    <h5 class="mb-2">Transferencia bancaria</h5>
                    @if (Model.ShippingToConfirm)
                    {
                        <p class="mb-0">Espera a que la tienda confirme el recargo y el total antes de transferir. Te avisaremos cuando esté listo.</p>
                    }
                    else if (bank.Values.Any(value => !string.IsNullOrWhiteSpace(value)))
                    {
                        <dl class="row mb-3">
                            @if (!string.IsNullOrWhiteSpace(bank.GetValueOrDefault("BankName"))) { <dt class="col-sm-4">Banco</dt><dd class="col-sm-8">@bank["BankName"]</dd> }
                            @if (!string.IsNullOrWhiteSpace(bank.GetValueOrDefault("BankAccountType"))) { <dt class="col-sm-4">Tipo</dt><dd class="col-sm-8">@bank["BankAccountType"]</dd> }
                            @if (!string.IsNullOrWhiteSpace(bank.GetValueOrDefault("BankAccountNumber"))) { <dt class="col-sm-4">Cuenta</dt><dd class="col-sm-8">@bank["BankAccountNumber"]</dd> }
                            @if (!string.IsNullOrWhiteSpace(bank.GetValueOrDefault("BankAccountHolder"))) { <dt class="col-sm-4">Titular</dt><dd class="col-sm-8">@bank["BankAccountHolder"]</dd> }
                            @if (!string.IsNullOrWhiteSpace(bank.GetValueOrDefault("BankAccountId"))) { <dt class="col-sm-4">Identificación</dt><dd class="col-sm-8">@bank["BankAccountId"]</dd> }
                        </dl>
                        @if (ViewBag.CanUploadPaymentProof is true)
                        {
                            <form asp-action="UploadPaymentProof" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderNumber" value="@Model.OrderNumber" />
                                <input type="hidden" name="accessToken" value="@ViewBag.AccessToken" />
                                <label class="form-label" for="proof-file">Comprobante (JPG, PNG, WebP o PDF; máximo 5 MB)</label>
                                <input class="form-control" id="proof-file" type="file" name="proof" accept="image/jpeg,image/png,image/webp,application/pdf" required />
                                <button class="btn btn-brand mt-3" type="submit">Enviar comprobante</button>
                                <p class="small text-muted mt-2 mb-0">Puedes enviar hasta 3 comprobantes. El archivo solo lo ve el equipo autorizado.</p>
                            </form>
                        }
                        else if (Model.PaymentStatus == PaymentStatus.Pending && !Model.ShippingToConfirm && paymentProofs.Count >= 3)
                        {
                            <p class="mb-0">Ya enviaste el máximo de 3 comprobantes. Espera la revisión de la tienda.</p>
                        }
                    }
                    else
                    {
                        <p class="mb-0">Los datos de transferencia aún no están configurados. Contacta a la tienda para recibirlos.</p>
                    }
                    @if (paymentProofs.Count > 0)
                    {
                        <h6 class="mt-3">Comprobantes enviados</h6>
                        <ul class="mb-0">
                            @foreach (var proof in paymentProofs)
                            {
                                <li><a asp-action="PaymentProof" asp-route-id="@proof.Id" asp-route-orderNumber="@Model.OrderNumber" asp-route-accessToken="@ViewBag.AccessToken">Comprobante @proof.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")</a> · @proof.Status @if (!string.IsNullOrWhiteSpace(proof.ReviewNote)) { <span>— @proof.ReviewNote</span> }</li>
                            }
                        </ul>
                    }
                </div>
            }

            <div class="text-center">
                @if (ViewBag.WhatsAppUrl is string whatsAppUrl)
                {
                    <a class="btn btn-success" href="@whatsAppUrl" target="_blank" rel="noopener noreferrer">Coordinar por WhatsApp</a>
                }
                <a class="btn btn-outline-brand" asp-controller="Order" asp-action="Index"><i class="bi bi-receipt me-2"></i>Ver mis pedidos</a>
                <a class="btn btn-brand" asp-controller="Catalog" asp-action="Index">Seguir comprando</a>
            </div>
        </div>
    </div>
</section>
