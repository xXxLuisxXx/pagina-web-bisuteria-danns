@model CheckoutViewModel

<section class="page-hero">
    <div class="container">
        <h1>Finalizar compra</h1>
        <p>Completa tus datos de envío y confirma tu pedido.</p>
    </div>
</section>

<div class="container py-4">
    @await Html.PartialAsync("_Alerts")

    <form asp-action="Index" method="post" class="row g-4">
        <input asp-for="CheckoutToken" type="hidden" />
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" role="alert" class="text-danger"></div>

        <div class="col-lg-7">
            <div class="card card-body shadow-sm mb-4">
                <h5 class="mb-3"><i class="bi bi-person me-2 text-gold"></i>Datos de contacto</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerName" class="form-label"></label>
                        <input asp-for="CustomerName" class="form-control" autocomplete="name" maxlength="160" />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CustomerPhone" class="form-label"></label>
                        <input asp-for="CustomerPhone" class="form-control" type="tel" inputmode="tel" autocomplete="tel" maxlength="20" />
                        <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="CustomerEmail" class="form-label"></label>
                        <input asp-for="CustomerEmail" class="form-control" type="email" inputmode="email" autocomplete="email" maxlength="200" />
                        <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card card-body shadow-sm mb-4">
                <h5 class="mb-3"><i class="bi bi-geo-alt me-2 text-gold"></i>Destino de entrega</h5>
                <div class="row g-3" id="deliveryAddress">
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label">Ciudad</label>
                        <select asp-for="City" class="form-select" autocomplete="address-level2">
                            <option value="Manta">Manta</option>
                            <option value="Jaramijó">Jaramijó</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DeliverySector" class="form-label">Sector</label>
                        <input asp-for="DeliverySector" class="form-control" list="deliverySectorSuggestions" maxlength="60" autocomplete="address-level3" placeholder="Escribe tu sector..." aria-describedby="deliveryZoneHelp" />
                        <datalist id="deliverySectorSuggestions">
                            @foreach (var zone in Model.DeliveryZones.Where(zone => zone.City == Model.City))
                            {
                                <option value="@zone.Sector"></option>
                            }
                        </datalist>
                        <span id="deliveryZoneHelp" class="form-text" aria-live="polite"></span>
                        <span asp-validation-for="DeliverySector" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="AddressLine1" class="form-label"></label>
                        <input asp-for="AddressLine1" class="form-control" autocomplete="street-address" />
                        <span asp-validation-for="AddressLine1" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="AddressLine2" class="form-label"></label>
                        <input asp-for="AddressLine2" class="form-control" autocomplete="address-line2" />
                    </div>
                    <div class="col-12">
                        <button class="btn btn-link p-0" type="button" data-bs-toggle="collapse" data-bs-target="#deliveryObservations" aria-expanded="@(string.IsNullOrWhiteSpace(Model.Observations) ? "false" : "true")" aria-controls="deliveryObservations">+ Añadir una nota para la entrega</button>
                        <div class="collapse @(string.IsNullOrWhiteSpace(Model.Observations) ? "" : "show") mt-2" id="deliveryObservations">
                            <label asp-for="Observations" class="form-label"></label>
                            <textarea asp-for="Observations" class="form-control" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-body shadow-sm mb-4 gift-card">
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsGift" class="form-check-input" type="checkbox" role="switch"
                           data-bs-toggle="collapse" data-bs-target="#giftDetails" aria-expanded="false" aria-controls="giftDetails" />
                    <label asp-for="IsGift" class="form-check-label fw-semibold"></label>
                </div>
                <div class="collapse @(Model.IsGift ? "show" : "")" id="giftDetails">
                    <p class="small text-muted mb-3">Incluye empaque especial y una nota personalizada sin precios visibles.</p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="GiftRecipientName" class="form-label"></label>
                            <input asp-for="GiftRecipientName" class="form-control" placeholder="¿Para quién es?" />
                        </div>
                        <div class="col-12">
                            <label asp-for="GiftMessage" class="form-label"></label>
                            <textarea asp-for="GiftMessage" class="form-control" rows="2" maxlength="300"
                                      placeholder="Ej: Feliz cumpleaños, que todos tus deseos se cumplan ✨"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-body shadow-sm mb-4">
                <h5 class="mb-3"><i class="bi bi-truck me-2 text-gold"></i>Método de entrega</h5>
                <div class="d-flex flex-column gap-2" id="deliveryOptions">
                    <label class="payment-option">
                        <input type="radio" asp-for="DeliveryMethod" value="Shipping" />
                        <i class="bi bi-box-seam"></i>
                        <div>
                            <strong>Envío a domicilio</strong>
                            <div class="small text-muted">Elige la ciudad y el sector para consultar el costo.</div>
                        </div>
                    </label>
                    <label class="payment-option">
                        <input type="radio" asp-for="DeliveryMethod" value="LocalDelivery" />
                        <i class="bi bi-geo-alt"></i>
                        <div>
                            <strong>Entrega local</strong>
                            <div class="small text-muted">El costo se consulta por sector y puede requerir confirmación.</div>
                        </div>
                    </label>
                    <label class="payment-option">
                        <input type="radio" asp-for="DeliveryMethod" value="Pickup" />
                        <i class="bi bi-shop"></i>
                        <div>
                            <strong>Retiro en tienda</strong>
                            <div class="small text-muted">Retira tu pedido coordinando con nosotros por WhatsApp.</div>
                        </div>
                    </label>
                </div>
            </div>

            <div class="card card-body shadow-sm mb-4">
                <h5 class="mb-3"><i class="bi bi-credit-card me-2 text-gold"></i>Método de pago</h5>
                @{ var methods = ViewBag.AvailablePayments as Bisuteria.Domain.Enums.PaymentMethod[] ?? []; }
                @if (methods.Length == 0)
                {
                    <p role="status">Las compras están pendientes de la configuración de pago. Contacta con la tienda para más información.</p>
                }
                @foreach (var method in methods)
                {
                    <label class="payment-option"><input type="radio" asp-for="PaymentMethod" value="@method" />
                    @(method == Bisuteria.Domain.Enums.PaymentMethod.BankTransfer ? "Transferencia bancaria" : "Contra entrega")</label>
                }

            </div>
        </div>

        <div class="col-lg-5">
            <div class="cart-summary card shadow-sm sticky-lg-top checkout-summary">
                <details id="checkoutOrderDetails" open>
                <summary class="checkout-order-toggle d-lg-none">Resumen del pedido <span class="small" id="mobileTotalDisplay">@TotalText(Model.Cart, Model.DeliveryMethod, Model.ShippingCost, Model.ShippingToConfirm)</span></summary>
                <h2 class="h5 mb-3 d-none d-lg-block">Tu pedido</h2>
                @foreach (var item in Model.Cart.Items)
                {
                    <div class="checkout-line mb-2">
                        <div class="checkout-thumb"><img src="@(item.ImageUrl ?? "/img/placeholder.svg")" alt="@item.Name" width="64" height="64" loading="lazy" decoding="async"></div>
                        <div class="checkout-line__content small">
                            <div class="checkout-line__name">@item.Name <span class="text-muted">x @item.Quantity</span></div>
                            @if (item.IsPersonalized)
                            {
                                <div class="checkout-line__customization text-gold small"><i class="bi bi-magic"></i> @item.CustomizationSummary</div>
                            }
                        </div>
                        <strong class="checkout-line__price small">@item.LineTotal.ToString("C")</strong>
                    </div>
                }
                <hr>
                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal</span><strong>@Model.Cart.Subtotal.ToString("C")</strong>
                </div>
                @if (Model.Cart.Discount > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span>Descuento (@Model.Cart.CouponCode)</span><strong>-@Model.Cart.Discount.ToString("C")</strong>
                    </div>
                }
                <div class="d-flex justify-content-between mb-2">
                    <span>Envío</span><strong id="shippingDisplay" class="text-muted">@ShippingText(Model.DeliveryMethod, Model.DeliveryZones.SingleOrDefault(zone => zone.Id == Model.DeliveryZoneId))</strong>
                </div>
                <hr>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-5">Total</span>
                    <strong class="fs-4 text-gold" id="totalDisplay">@TotalText(Model.Cart, Model.DeliveryMethod, Model.ShippingCost, Model.ShippingToConfirm)</strong>
                </div>
                </details>
                <button class="btn btn-brand btn-lg w-100" type="submit" data-confirm-order disabled="@(methods.Length == 0)">
                    <i class="bi bi-check2-circle me-2"></i>Confirmar pedido
                </button>
                <a class="btn btn-link w-100 mt-2" asp-controller="Cart" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Volver al carrito</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script id="deliveryZonesData" type="application/json" nonce="@Context.Items["CspNonce"]">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DeliveryZones))</script>
    <script nonce="@Context.Items["CspNonce"]">
        (function () {
            var form = document.querySelector('input[name="CheckoutToken"]').form;
            var submitting = false;
            var submitButton = form.querySelector('button[data-confirm-order]');
            var paymentUnavailable = submitButton.disabled;
            window.addEventListener('pageshow', function () { submitting = false; submitButton.disabled = paymentUnavailable; update(); });
            form.addEventListener('submit', function (event) {
                if (submitting) { event.preventDefault(); return; }
                if (event.submitter && event.submitter.name === 'CheckoutIntentRefreshZones') return;
                if (window.jQuery && !window.jQuery(form).valid()) return;
                if (!form.checkValidity()) return;
                submitting = true;
                submitButton.disabled = true;
                submitButton.textContent = 'Enviando pedido…';
                form.setAttribute('aria-busy', 'true');
            });
            var radios = document.querySelectorAll('#deliveryOptions input[type="radio"]');
            var shipRow = document.getElementById('shippingDisplay');
            var city = document.getElementById('City');
            var sector = document.getElementById('DeliverySector');
            var suggestions = document.getElementById('deliverySectorSuggestions');
            var help = document.getElementById('deliveryZoneHelp');
            var address = document.getElementById('deliveryAddress');
            var zones = JSON.parse(document.getElementById('deliveryZonesData').textContent);
            var subtotal = @((Model.Cart.Subtotal - Model.Cart.Discount).ToString(System.Globalization.CultureInfo.InvariantCulture));
            var totalRow = document.getElementById('totalDisplay');
            var orderDetails = document.getElementById('checkoutOrderDetails');
            var desktop = window.matchMedia('(min-width: 992px)');
            function resizeSummary() { orderDetails.open = desktop.matches; }
            desktop.addEventListener('change', resizeSummary);
            resizeSummary();

            function normalize(value) {
                return value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().replace(/\s+/g, ' ').toLocaleUpperCase('es');
            }

            function filterZones() {
                if (!city || !suggestions) return;
                suggestions.replaceChildren();
                zones.filter(function (item) { return item.City === city.value; }).forEach(function (item) {
                    suggestions.appendChild(new Option(item.Sector));
                });
            }

            function update() {
                var selected = document.querySelector('#deliveryOptions input[type="radio"]:checked');
                if (!selected || !shipRow) return;
                var pickup = selected.value === 'Pickup';
                var typedSector = sector ? sector.value.trim() : '';
                var matches = !pickup && typedSector ? zones.filter(function (item) { return item.City === city.value && normalize(item.Sector) === normalize(typedSector); }) : [];
                var match = matches.length === 1 ? matches[0] : null;
                var pending = !pickup && (!typedSector || !match || match.RequiresConfirmation);
                var free = match && match.IsFree;
                var cost = match && !match.RequiresConfirmation && !match.IsFree ? Number(match.Cost) : 0;
                var estimate = !typedSector ? '' : pending ? 'Lo cotizamos y te confirmamos antes del pago' : free ? 'Envío gratis' : 'Envío: ' + cost.toLocaleString('es-EC', { style: 'currency', currency: 'USD' });
                help.textContent = estimate;
                shipRow.textContent = pickup ? 'No aplica' : pending ? (typedSector ? 'Envío por confirmar' : 'Se calcula según el lugar de entrega') : free ? 'Envío gratis' : cost.toLocaleString('es-EC', { style: 'currency', currency: 'USD' });
                shipRow.classList.toggle('text-muted', pending);
                if (address) address.hidden = pickup;
                form.querySelector('[name="AddressLine1"]').required = !pickup;
                if (sector) sector.required = !pickup;
                var submit = form.querySelector('button[data-confirm-order]');
                if (submit && !submitting) submit.textContent = pending && !pickup && typedSector ? 'Enviar pedido para cotización' : 'Confirmar pedido';
                totalRow.textContent = pending
                    ? 'Envío por confirmar'
                    : Math.max(0, subtotal + cost).toLocaleString('es-EC', { style: 'currency', currency: 'USD' });
                document.getElementById('mobileTotalDisplay').textContent = totalRow.textContent;
            }

            radios.forEach(function (r) { r.addEventListener('change', update); });
            if (city) city.addEventListener('change', function () { filterZones(); update(); });
            if (sector) sector.addEventListener('input', update);
            filterZones();
            update();
        })();
    </script>
}

@functions {
    private static string ShippingText(Bisuteria.Domain.Enums.DeliveryMethod method, DeliveryZoneOption? zone)
    {
        if (method == Bisuteria.Domain.Enums.DeliveryMethod.Pickup) return "No aplica";
        if (zone is null || zone.RequiresConfirmation) return "Se calcula según el lugar de entrega";
        return zone.IsFree ? "Envío gratis" : zone.Cost.ToString("C");
    }

    private static string TotalText(Bisuteria.Application.DTOs.Cart.CartDto cart, Bisuteria.Domain.Enums.DeliveryMethod method, decimal shippingCost, bool pending)
    {
        if (method != Bisuteria.Domain.Enums.DeliveryMethod.Pickup && pending) return "Envío por confirmar";
        var total = Math.Max(0m, cart.Subtotal - cart.Discount) + (method == Bisuteria.Domain.Enums.DeliveryMethod.Pickup ? 0m : shippingCost);
        return total.ToString("C");
    }
}
