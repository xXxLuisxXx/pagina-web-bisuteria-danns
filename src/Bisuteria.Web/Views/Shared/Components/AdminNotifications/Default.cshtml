@model AdminNotificationSummary
@{ var total = Model.Total; }
<details class="admin-notifications"><summary aria-label="Notificaciones: @total pendientes"><i class="bi bi-bell" aria-hidden="true"></i><span class="notification-count">@total</span></summary>
<div class="admin-popover"><strong>Requieren atención</strong>
@foreach (var alert in Model.Alerts) { <a href="@alert.Url">@alert.Label: @alert.Count</a> }
@if (Model.Alerts.Count == 0) { <p class="small mb-0">No hay avisos pendientes para tus permisos.</p> }
<small>Se actualiza al navegar, con caché de 30 segundos.</small></div></details>
