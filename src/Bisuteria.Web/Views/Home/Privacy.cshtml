@{
    var privacyPolicyText = ViewBag.PrivacyPolicyText as string;
}

<section class="page-hero">
    <div class="container">
        <h1>Política de privacidad</h1>
        <p>Información sobre el tratamiento de datos personales de la tienda.</p>
    </div>
</section>

<div class="container py-4">
    <div class="mx-auto content-width">
        @if (string.IsNullOrWhiteSpace(privacyPolicyText))
        {
            <div class="alert alert-warning" role="status">
                La política de privacidad todavía está pendiente de publicación. La propietaria debe configurarla desde el panel antes de operar con clientes.
            </div>
        }
        else
        {
            <div class="privacy-policy-text">@privacyPolicyText</div>
        }
        <p class="small text-muted mt-4">
            La propietaria debe revisar este texto con asesoría legal y conforme a la normativa ecuatoriana de protección de datos personales.
        </p>
    </div>
</div>
