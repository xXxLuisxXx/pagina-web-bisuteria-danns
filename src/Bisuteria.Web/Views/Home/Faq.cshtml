@inject ISettingService SettingsService
@{
    ViewData["Description"] = "Preguntas frecuentes sobre pedidos, entregas en Manta y Jaramijó, pagos y cambios de Bisuterías Dann’s.";
    var faqSettings = await SettingsService.GetAllAsync();
    var productionTime = faqSettings.GetValueOrDefault("ProductionTimeText");
    var returnsPolicy = faqSettings.GetValueOrDefault("ReturnsPolicyText");
}

<section class="page-hero">
    <div class="container">
        <h1>Preguntas frecuentes</h1>
        <p>Resolvemos tus dudas más comunes.</p>
    </div>
</section>

<div class="container py-4">
    <div class="mx-auto content-width">
        <div class="accordion" id="faqAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                        ¿Cuánto tarda la producción de una pieza personalizada?
                    </button>
                </h2>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        @(string.IsNullOrWhiteSpace(productionTime) ? "La tienda confirmará el plazo de preparación antes de concretar el pedido." : productionTime)
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                        ¿Qué métodos de pago aceptan?
                    </button>
                </h2>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Al finalizar la compra verás los métodos de pago habilitados. Si eliges transferencia bancaria, espera a tener el total confirmado y sigue las instrucciones del pedido.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                        ¿Cuánto cuesta el envío?
                    </button>
                </h2>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Hacemos <strong>envíos en Manta y Jaramijó, Manabí</strong>. El costo depende del sector y se muestra al finalizar la compra.
                        Una zona puede estar marcada con envío gratis; si el sector requiere cotización, la tienda confirma el recargo y el total antes del pago.
                        <a asp-controller="Home" asp-action="Shipping">Consulta la cobertura y las condiciones de entrega.</a>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                        ¿Los materiales son hipoalergénicos?
                    </button>
                </h2>
                <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Sí. Utilizamos <strong>acero inoxidable y baño de oro 18k hipoalergénico</strong>,
                        libres de níquel, para cuidar la piel de nuestros clientes.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                        ¿Puedo devolver o cambiar una pieza?
                    </button>
                </h2>
                <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        @(string.IsNullOrWhiteSpace(returnsPolicy) ? "Las condiciones de cambios y devoluciones están pendientes de confirmar por la tienda. Consúltalas antes de concretar tu compra." : returnsPolicy)
                        <a asp-controller="Home" asp-action="Shipping">Consulta la política de envíos y devoluciones.</a>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq6">
                        ¿Hacen pedidos corporativos o al mayoreo?
                    </button>
                </h2>
                <div id="faq6" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        ¡Sí! Hacemos piezas personalizadas para <strong>eventos, empresas y regalos corporativos</strong>.
                        Escríbenos en la sección de contacto y te compartimos una cotización.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
