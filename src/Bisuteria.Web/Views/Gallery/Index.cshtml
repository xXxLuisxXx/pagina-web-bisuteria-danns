@model IReadOnlyList<GalleryImageDto>
@{
    var categories = ViewBag.Categories as List<string> ?? new();
    var active = ViewBag.ActiveCategory as string;
}

<section class="page-hero">
    <div class="container">
        <h1>Galería</h1>
        <p>Inspírate con las piezas que hemos creado para nuestros clientes.</p>
    </div>
</section>

<div class="container py-4">
    <div class="d-flex flex-wrap gap-2 justify-content-center mb-4">
        <a class="btn btn-sm @(string.IsNullOrEmpty(active) ? "btn-dark-brand" : "btn-outline-brand")" asp-action="Index">Todas</a>
        @foreach (var cat in categories)
        {
            <a class="btn btn-sm @(active == cat ? "btn-dark-brand" : "btn-outline-brand")" asp-action="Index" asp-route-category="@cat">@cat</a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-images empty-icon empty-icon-lg"></i>
            <p class="mt-3">Pronto publicaremos más fotos de nuestras creaciones.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var image in Model)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="gallery-item">
                        <img loading="lazy" src="@image.ImageUrl" alt="@image.Title" />
                        @if (!string.IsNullOrWhiteSpace(image.Title))
                        {
                            <div class="overlay">
                                <span>@image.Title</span>
                                @if (!string.IsNullOrWhiteSpace(image.Category))
                                {
                                    <small>@image.Category</small>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
