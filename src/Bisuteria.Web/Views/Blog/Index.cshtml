@model PaginatedBlogResult

<section class="page-hero">
    <div class="container">
        <h1>Blog · Consejos y tendencias</h1>
        <p>Ideas para elegir, cuidar y lucir tu bisutería personalizada.</p>
    </div>
</section>

<div class="container py-4">
    <form asp-action="Index" method="get" class="row justify-content-center mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <input type="search" name="search" class="form-control" placeholder="Buscar artículos..." value="@ViewBag.Search" />
                <button class="btn btn-brand" type="submit"><i class="bi bi-search"></i></button>
            </div>
        </div>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-journal-text empty-icon empty-icon-lg"></i>
            <p class="mt-3">No hay artículos que coincidan con tu búsqueda.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var post in Model.Items)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="blog-card animate-on-scroll">
                        <div class="img-wrap">
                            <img loading="lazy" src="@(post.CoverImage ?? "/img/placeholder.svg")" alt="@post.Title">
                        </div>
                        <div class="body">
                            <div class="blog-meta">
                                @if (post.PublishedAt.HasValue)
                                {
                                    <span>@post.PublishedAt.Value.ToString("dd MMM yyyy")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(post.Author))
                                {
                                    <span> · @post.Author</span>
                                }
                            </div>
                            <h3><a asp-controller="Blog" asp-action="Details" asp-route-slug="@post.Slug">@post.Title</a></h3>
                            <p>@post.Excerpt</p>
                            <a class="read-more text-gold" asp-controller="Blog" asp-action="Details" asp-route-slug="@post.Slug">Leer más <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </article>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5" aria-label="Paginación">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.Page > 1 ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@ViewBag.Search"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page < Model.TotalPages ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@ViewBag.Search"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
