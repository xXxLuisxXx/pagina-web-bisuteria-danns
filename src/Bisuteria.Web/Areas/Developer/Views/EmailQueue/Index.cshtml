@model IReadOnlyList<Bisuteria.Web.Areas.Developer.Controllers.EmailQueueRow>
@{
    ViewData["Title"] = "Cola de correo";
}
<h2 class="h3">Cola de correo</h2>
<p class="text-secondary">Se muestran hasta 100 mensajes pendientes. Los destinatarios aparecen parcialmente ocultos.</p>
<div class="table-responsive" role="region" aria-label="Mensajes de correo pendientes" tabindex="0">
    <table class="table align-middle">
        <thead><tr><th>Tipo</th><th>Destinatario</th><th>Intentos</th><th>Próximo intento (UTC)</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-secondary py-4">No hay mensajes pendientes.</td></tr>
        }
        @foreach (var row in Model)
        {
            <tr>
                <td>@row.Kind</td>
                <td>@row.Recipient</td>
                <td>@row.Attempts / 8</td>
                <td>@row.NextAttemptAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@(row.LastError ?? (row.Failed ? "Requiere reintento" : "Pendiente"))</td>
                <td>
                    @if (row.Failed)
                    {
                        <form asp-action="RetryFailed" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@row.Id" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">Reintentar envío</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
