@model Bisuteria.Web.Areas.Developer.Controllers.RoleMatrixViewModel
@{
    ViewData["Title"] = "Matriz de roles y permisos";
}
<h2 class="h3">Matriz de roles y permisos</h2>
<p class="text-secondary">Solo puedes editar los permisos de Owner y Operator. Los cambios cierran las sesiones actuales de sus cuentas.</p>
<div class="row g-4">
@foreach (var role in new[] { "Owner", "Operator" })
{
    var granted = Model.Grants.TryGetValue(role, out var set) ? set : new HashSet<string>();
    <div class="col-12 col-xl-6">
        <section class="card shadow-sm"><div class="card-body">
            <h3 class="h5">@role</h3>
            <form asp-area="Developer" asp-controller="Roles" asp-action="Save" method="post" data-confirm="Cambiar permisos cerrará las sesiones activas de ese rol. ¿Confirmas el cambio?">
                @Html.AntiForgeryToken()
                <input type="hidden" name="role" value="@role" />
                <div class="row row-cols-1 row-cols-md-2 g-2 mb-3">
                @foreach (var permission in Model.Permissions.Where(permission => Bisuteria.Domain.Security.StorePermissions.CanAssignTo(role, permission)))
                {
                    <label class="col form-check"><input class="form-check-input" type="checkbox" name="permissions" value="@permission" @(granted.Contains(permission) ? "checked" : null) /> <span class="form-check-label">@permission</span></label>
                }
                </div>
                <button class="btn btn-primary" type="submit">Guardar matriz de @role</button>
            </form>
        </div></section>
    </div>
}
</div>
