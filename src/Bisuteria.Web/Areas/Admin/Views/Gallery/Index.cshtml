@model IReadOnlyList<Bisuteria.Application.DTOs.Catalog.GalleryImageDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="admin-title mb-0">Galería</h1>
        <span class="text-muted small">@Model.Count imagen(es) publicada(s)</span>
    </div>
    <a class="btn btn-gold" asp-action="Edit"><i class="bi bi-plus-lg me-2"></i>Nueva imagen</a>
</div>

@if (Model.Count == 0)
{
    <div class="card-admin text-center py-5">
        <i class="bi bi-images" style="font-size: 3rem; color: var(--brand-gold);"></i>
        <h5 class="mt-3">La galería está vacía</h5>
        <p class="text-muted mb-4">Sube fotos de tus creaciones para inspirar a tus clientes.</p>
        <a class="btn btn-gold" asp-action="Edit"><i class="bi bi-plus-lg me-2"></i>Agregar la primera imagen</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var image in Model)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card-admin p-2 h-100">
                    <img src="@image.ImageUrl" alt="@image.Title" class="img-fluid rounded" style="height: 180px; width: 100%; object-fit: cover;" />
                    <div class="p-2">
                        <div class="fw-semibold small text-truncate">@(image.Title ?? "Sin título")</div>
                        <div class="text-muted small">@image.Category</div>
                        <div class="d-flex gap-2 mt-2">
                            <a class="btn btn-sm btn-outline-secondary flex-fill" asp-action="Edit" asp-route-id="@image.Id">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" method="post" class="flex-fill"
                                  onsubmit="return confirm('¿Eliminar esta imagen de la galería?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@image.Id" />
                                <button class="btn btn-sm btn-outline-danger w-100" type="submit"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
