@model Bisuteria.Application.DTOs.Catalog.GalleryImageDto

<div class="mb-4">
    <a class="text-muted small text-decoration-none" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Volver a la galería</a>
    <h1 class="admin-title mt-2 mb-0">@(Model.Id == 0 ? "Nueva imagen" : "Editar imagen")</h1>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" role="alert" class="text-danger mb-3"></div>

            <div class="card-admin p-3 mb-3">
                <div class="mb-3">
                    <label class="form-label">Imagen</label>
                    <input type="file" name="imageFile" class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <div class="form-text">JPG, PNG o WebP · máx. 8 MB. Se optimiza automáticamente al guardar.</div>
                </div>
                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label">URL de la imagen (opcional si subes un archivo)</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="/img/uploads/gallery/..." />
                </div>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Título</label>
                    <input asp-for="Title" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Category" class="form-label">Categoría visual</label>
                    <input asp-for="Category" class="form-control" placeholder="Ej: Pulseras, Collares, Personalizados..." />
                    <div class="form-text">Se usa para los filtros de la galería pública.</div>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Descripción (opcional)</label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="IsFeatured" class="form-check-input" />
                    <label asp-for="IsFeatured" class="form-check-label">Destacada</label>
                </div>
            </div>

            <button class="btn btn-gold btn-lg" type="submit"><i class="bi bi-check2 me-2"></i>Guardar imagen</button>
        </form>
    </div>
    <div class="col-lg-5">
        <div class="card-admin p-3 text-center">
            <h6 class="fw-semibold mb-3">Vista previa</h6>
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded" style="max-height: 320px;" />
            }
            else
            {
                <img src="/img/placeholder.svg" alt="Sin imagen" class="img-fluid rounded" style="max-height: 320px;" />
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
