@model IReadOnlyList<UserDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="admin-title mb-0">Usuarios</h1>
</div>

<div class="card-admin">
    <div class="table-responsive">
        <table class="table table-admin mb-0">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Contacto</th>
                    <th>Registro</th>
                    <th class="text-center">Pedidos</th>
                    <th class="text-end">Total gastado</th>
                    <th class="text-center">Rol</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var canToggle = User.IsInRole(Bisuteria.Domain.Security.StoreRoles.Developer)
                        ? user.Roles.Any(role => role is Bisuteria.Domain.Security.StoreRoles.Developer or Bisuteria.Domain.Security.StoreRoles.Owner or Bisuteria.Domain.Security.StoreRoles.Operator)
                        : User.IsInRole(Bisuteria.Domain.Security.StoreRoles.Owner) && user.Roles.Contains(Bisuteria.Domain.Security.StoreRoles.Operator);
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-admin">@(string.IsNullOrWhiteSpace(user.FullName) ? "?" : System.Globalization.StringInfo.GetNextTextElement(user.FullName.Trim()).ToUpperInvariant())</span>
                                <strong>@(string.IsNullOrWhiteSpace(user.FullName) ? "Sin nombre" : user.FullName)</strong>
                            </div>
                        </td>
                        <td>
                            @user.Email<br>
                            <small class="text-muted">@(user.City ?? "-") · @(user.Province ?? "-")</small>
                        </td>
                        <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-center">@user.OrderCount</td>
                        <td class="text-end fw-semibold">@user.TotalSpent.ToString("C")</td>
                        <td class="text-center">
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge badge-status @(role == "Admin" ? "bg-gold text-white" : "bg-secondary")">@role</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (user.IsActive)
                            {
                                <span class="badge badge-status bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge badge-status bg-danger">Desactivado</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (User.IsInRole(Bisuteria.Domain.Security.StoreRoles.Developer) && user.Roles.Contains(Bisuteria.Domain.Security.StoreRoles.Customer))
                            {
                                <form asp-action="Reveal" method="post" class="m-0 d-inline" data-confirm="Se registrará el acceso a los datos del cliente. ¿Continuar?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Ver datos</button>
                                </form>
                            }
                            @if (canToggle)
                            {
                                <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post" class="m-0" data-confirm="¿Cambiar el estado de este usuario?">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-secondary" type="submit" title="Cambiar estado"><i class="bi @(user.IsActive ? "bi-person-dash" : "bi-person-check")"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<nav aria-label="Paginación de usuarios" class="d-flex gap-3 my-3">
    @if ((int)(ViewBag.Page ?? 1) > 1) { <a asp-action="Index" asp-route-page="@((int)ViewBag.Page - 1)">Anterior</a> }
    <span>Página @(ViewBag.Page ?? 1)</span>
    @if (Model.Count == 25) { <a asp-action="Index" asp-route-page="@((int)(ViewBag.Page ?? 1) + 1)">Siguiente</a> }
</nav>
