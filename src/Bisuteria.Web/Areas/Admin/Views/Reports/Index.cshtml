<div class="mb-4">
    <h1 class="admin-title mb-1">Reportes</h1>
    <p class="text-muted mb-0">Analiza las ventas y el desempeño de tus productos, y exporta la información.</p>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card-admin p-4">
            <div class="feature-icon mb-3"><i class="bi bi-cash-stack"></i></div>
            <h5>Reporte de ventas</h5>
            <p class="text-muted">Detalle de pedidos, montos y estados. Exportable a Excel o CSV.</p>
            <a class="btn btn-gold" asp-action="Sales"><i class="bi bi-graph-up me-2"></i>Ver reporte</a>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card-admin p-4">
            <div class="feature-icon mb-3"><i class="bi bi-box-seam"></i></div>
            <h5>Reporte de productos</h5>
            <p class="text-muted">Rendimiento por producto: unidades vendidas, stock e ingresos.</p>
            <a class="btn btn-gold" asp-action="Products"><i class="bi bi-table me-2"></i>Ver reporte</a>
        </div>
    </div>
</div>
