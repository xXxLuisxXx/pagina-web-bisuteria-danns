@model IReadOnlyList<SalesReportRow>

<div class="mb-4">
    <a class="text-muted small text-decoration-none" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Volver a reportes</a>
    <h1 class="admin-title mt-2 mb-0">Reporte de ventas</h1>
</div>

<form asp-action="Sales" method="get" class="d-flex flex-wrap gap-2 align-items-end mb-3">
    <div>
        <label class="form-label small mb-0">Desde</label>
        <input type="date" name="from" class="form-control form-control-sm" value="@(ViewBag.From?.ToString("yyyy-MM-dd"))" />
    </div>
    <div>
        <label class="form-label small mb-0">Hasta</label>
        <input type="date" name="to" class="form-control form-control-sm" value="@(ViewBag.To?.ToString("yyyy-MM-dd"))" />
    </div>
    <div>
        <label class="form-label small mb-0">Estado</label>
        <select name="status" class="form-select form-select-sm">
            <option value="">Todos</option>
            @foreach (var status in (OrderStatus[])ViewBag.Statuses)
            {
                <option value="@status" selected="@((OrderStatus?)ViewBag.Status == status)">@status</option>
            }
        </select>
    </div>
    <div>
        <label for="payment" class="form-label small mb-0">Estado de pago</label>
        <select id="payment" name="payment" class="form-select form-select-sm">
            <option value="">Todos los pagos</option>
            @foreach (var payment in Enum.GetValues<PaymentStatus>())
            {
                <option value="@payment" selected="@((PaymentStatus?)ViewBag.Payment == payment)">@payment.GetLabel()</option>
            }
        </select>
    </div>
    <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-funnel me-1"></i>Filtrar</button>
    <a class="btn btn-sm btn-outline-success" asp-action="ExportSales" asp-route-status="@ViewBag.Status" asp-route-payment="@ViewBag.Payment" asp-route-from="@ViewBag.From?.ToString("yyyy-MM-dd")" asp-route-to="@ViewBag.To?.ToString("yyyy-MM-dd")"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
    <a class="btn btn-sm btn-outline-info" asp-action="ExportCsv" asp-route-report="sales" asp-route-status="@ViewBag.Status" asp-route-payment="@ViewBag.Payment" asp-route-from="@ViewBag.From?.ToString("yyyy-MM-dd")" asp-route-to="@ViewBag.To?.ToString("yyyy-MM-dd")"><i class="bi bi-filetype-csv me-1"></i>CSV</a>
</form>

<div class="d-flex gap-4 mb-3">
    <div class="stat-card" style="flex:1;">
        <div class="stat-value text-gold">@ViewBag.Total.ToString("C")</div>
        <div class="stat-label">Importe de pedidos no cancelados (no equivale a cobros)</div>
    </div>
    <div class="stat-card" style="flex:1;">
        <div class="stat-value">@ViewBag.Count</div>
        <div class="stat-label">Pedidos</div>
    </div>
</div>

<div class="card-admin">
    <div class="table-responsive">
        <table class="table table-admin mb-0">
            <thead>
                <tr>
                    <th>Pedido</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Provincia</th>
                    <th class="text-center">Art.</th>
                    <th class="text-end">Subtotal</th>
                    <th class="text-end">Descuento</th>
                    <th class="text-end">Envío</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td><strong>@row.OrderNumber</strong></td>
                        <td>@row.Date.ToString("dd MMM yyyy")</td>
                        <td>@row.Customer</td>
                        <td>@row.Province</td>
                        <td class="text-center">@row.Items</td>
                        <td class="text-end">@row.Subtotal.ToString("C")</td>
                        <td class="text-end text-success">-@row.Discount.ToString("C")</td>
                        <td class="text-end">@row.Shipping.ToString("C")</td>
                        <td class="text-end fw-semibold text-gold">@row.Total.ToString("C")</td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No hay ventas para el filtro seleccionado.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
