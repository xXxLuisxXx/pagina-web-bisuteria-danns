@model IReadOnlyList<ChartPoint>
@{ var maximum = Model.Count == 0 ? 0 : Model.Max(p => p.Value); }
@if (Model.Count == 0 || maximum == 0) { <p class="text-muted">Sin datos para este periodo.</p> }
else {
    <div class="dashboard-bars" tabindex="0" role="region" aria-label="Datos del gráfico; desplaza para ver más filas">
    @foreach (var point in Model) {
        <div class="mb-2"><div class="d-flex justify-content-between gap-3 small"><span>@point.Label</span><strong>@point.Value.ToString("N2")</strong></div>
            <svg width="100%" height="12" aria-hidden="true"><rect width="100%" height="12" fill="#eee8da" rx="4" /><rect width="@((point.Value / maximum * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%" height="12" fill="#806020" rx="4" /></svg>
        </div>
    }
    </div>
}
