@model DashboardStats
@using Bisuteria.Application.Services
@using Bisuteria.Domain.Security
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{
    async Task<bool> Allowed(string permission) => (await Authorization.AuthorizeAsync(User, null, permission)).Succeeded;
    var canExport = await Allowed(StorePermissions.ReportsExport);
    var canViewOrders = await Allowed(StorePermissions.OrdersView);
    var canUpdateOrders = await Allowed(StorePermissions.OrdersUpdateStatus);
    var canEditSettings = await Allowed(StorePermissions.StoreSettingsEdit);
    var visibleAlerts = new List<DashboardAlert>();
    foreach (var alert in Model.Alerts)
        if (await Allowed(alert.Permission)) visibleAlerts.Add(alert);
    string Change(decimal current, decimal previous) => previous == 0 ? (current == 0 ? "Sin variación" : "Sin base anterior") : $"{(current > previous ? "↑" : current < previous ? "↓" : "↔")} {(current - previous) / previous:+0.0%;-0.0%;0.0%} frente al anterior";
    var today = SalesCriteria.Local(DateTime.UtcNow).Date;
    var monthStart = new DateTime(Model.To.Year, Model.To.Month, 1);
    var presets = new[] { ("Día", today, "day"), ("Semana", today.AddDays(-((int)today.DayOfWeek + 6) % 7), "day"), ("Mes", new DateTime(today.Year, today.Month, 1), "day"), ("Año", new DateTime(today.Year, 1, 1), "month") };
    var cards = new[] {
        ("Importe del periodo", Model.PeriodSales.ToString("C"), Change(Model.PeriodSales, Model.PreviousSales)),
        ("Pedidos del periodo", Model.PeriodOrders.ToString(), Change(Model.PeriodOrders, Model.PreviousOrders)),
        ("Ticket promedio", Model.AverageTicket.ToString("C"), Change(Model.AverageTicket, Model.PreviousTicket)),
        ("Clientes nuevos", Model.NewClients.ToString(), Change(Model.NewClients, Model.PreviousClients)),
        ("Productos activos", Model.TotalProducts.ToString(), "Estado actual · sin historial de activación")
    };
}
<div class="mb-4">
    <h1 class="admin-title">Panel de administración</h1>
    <p class="text-muted">Pedidos no cancelados · America/Guayaquil · importes de pedidos, no cobros confirmados.</p>
    <p class="small">Actualizado: @SalesCriteria.Local(Model.GeneratedAt).ToString("dd/MM/yyyy HH:mm:ss"). Caché de hasta 30 segundos.</p>
</div>
<nav class="period-pills mb-3" aria-label="Periodo del panel">@foreach(var preset in presets) { <a asp-action="Index" asp-route-from="@preset.Item2.ToString("yyyy-MM-dd")" asp-route-to="@today.ToString("yyyy-MM-dd")" asp-route-interval="@preset.Item3" aria-current="@((Model.From == preset.Item2 && Model.To == today).ToString().ToLowerInvariant())">@preset.Item1</a> }</nav>
<form method="get" class="card-admin p-3 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-sm-6 col-lg-3"><label for="from" class="form-label">Desde</label><input class="form-control" type="date" id="from" name="from" value="@Model.From.ToString("yyyy-MM-dd")" required /></div>
        <div class="col-sm-6 col-lg-3"><label for="to" class="form-label">Hasta</label><input class="form-control" type="date" id="to" name="to" value="@Model.To.ToString("yyyy-MM-dd")" required /></div>
        <div class="col-sm-6 col-lg-3"><label for="interval" class="form-label">Agrupar ventas</label><select class="form-select" id="interval" name="interval"><option value="day" selected="@(Model.Interval == "day")">Día</option><option value="week" selected="@(Model.Interval == "week")">Semana (lunes)</option><option value="month" selected="@(Model.Interval == "month")">Mes</option></select></div>
        <div class="col-sm-6 col-lg-3"><button class="btn btn-gold w-100" type="submit">Aplicar rango</button></div>
    </div>
    <p class="small text-muted mt-2 mb-0">Comparación con los @( (Model.To - Model.From).Days + 1 ) días anteriores. Máximo 367 días.</p>
</form>
@if (canExport)
{
<div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-outline-dark btn-sm" asp-action="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-interval="@Model.Interval" asp-route-format="xlsx">Exportar Excel</a>
    <a class="btn btn-outline-dark btn-sm" asp-action="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-interval="@Model.Interval" asp-route-format="csv">Exportar CSV</a>
</div>
}
<div class="row g-3 mb-4">
@foreach (var card in cards) {
    <div class="col-sm-6 col-xl"><div class="stat-card h-100 @(card.Item1 == "Importe del periodo" ? "kpi-featured" : "")"><div class="stat-label">@card.Item1</div><div class="stat-value">@card.Item2</div><div class="small mt-2 @(card.Item3.StartsWith("↑") ? "trend-up" : card.Item3.StartsWith("↓") ? "trend-down" : "")">@card.Item3</div></div></div>
}
</div>
<div class="dashboard-primary mb-4">
<section class="card-admin p-4"><h2 class="h5">Ventas del periodo</h2><p class="small text-muted">Importes de pedidos no cancelados · USD</p><partial name="_Columns" model="Model.SalesByMonth" /></section>
<section class="card-admin p-4"><div class="d-flex justify-content-between align-items-center mb-3"><a asp-action="Index" asp-route-from="@monthStart.AddMonths(-1).ToString("yyyy-MM-dd")" asp-route-to="@monthStart.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Mes anterior">←</a><h2 class="h6 mb-0">@monthStart.ToString("MMMM yyyy")</h2><a asp-action="Index" asp-route-from="@monthStart.AddMonths(1).ToString("yyyy-MM-dd")" asp-route-to="@monthStart.AddMonths(2).AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Mes siguiente">→</a></div>
<div class="calendar-grid">@foreach(var day in new[] { "Lu", "Ma", "Mi", "Ju", "Vi", "Sá", "Do" }) { <span>@day</span> }
@for(var i=0;i<((int)monthStart.DayOfWeek+6)%7;i++) { <span aria-hidden="true"></span> }
@for(var day=1;day<=DateTime.DaysInMonth(monthStart.Year,monthStart.Month);day++) { var date=monthStart.AddDays(day-1); var key=date.ToString("yyyy-MM-dd"); var count=Model.CalendarDays.FirstOrDefault(p=>p.Label==key)?.Value ?? 0; <a class="@(count>0 ? "has-orders" : "")" asp-action="Index" asp-route-from="@key" asp-route-to="@key" aria-label="@day: @date.ToString("dd MMMM"), @count pedidos no cancelados">@day</a> }
</div><p class="small text-muted mt-3">Los días oscuros tienen pedidos no cancelados.</p>
@{ var progress=Model.MonthlyGoal<=0 ? 0 : Math.Clamp(Model.CalendarSales/Model.MonthlyGoal*100,0,100); }
<div class="goal-ring border-top pt-3"><svg viewBox="0 0 120 120" role="img" aria-label="Avance de meta: @progress.ToString("0") por ciento"><circle cx="60" cy="60" r="46" fill="none" stroke="#dadade" stroke-width="10"/><circle cx="60" cy="60" r="46" fill="none" stroke="#826818" stroke-width="10" pathLength="100" stroke-dasharray="@progress.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture) 100" transform="rotate(-90 60 60)"/><text x="60" y="65" text-anchor="middle" fill="currentColor" font-size="20">@progress.ToString("0")%</text></svg><div><strong>Meta mensual</strong><p class="small mb-1">@Model.CalendarSales.ToString("C") / @Model.MonthlyGoal.ToString("C")</p>@if (canEditSettings) { <a href="/Admin/Settings" class="small">@(Model.MonthlyGoal == 0 ? "Configurar meta" : "Cambiar meta")</a> }</div></div></section></div>
<section class="card-admin p-3 mb-4" aria-labelledby="alerts-title">
    <h2 id="alerts-title" class="h5">Requieren atención</h2>
    <div class="d-flex flex-wrap gap-2">
    @foreach (var alert in visibleAlerts) { <a class="btn btn-outline-dark" href="@alert.Url">@alert.Label <strong class="ms-1">@alert.Count</strong></a> }
    </div>
    @if (visibleAlerts.All(a => a.Count == 0)) { <p class="mt-3 mb-0">No hay alertas pendientes.</p> }
</section>
<div class="row g-3 mb-4">
    <section class="col-lg-6"><div class="card-admin p-3 h-100"><h2 class="h5">Importe de pedidos por periodo</h2><partial name="_Chart" model="Model.SalesByMonth" /></div></section>
    <section class="col-lg-6"><div class="card-admin p-3 h-100"><h2 class="h5">Pedidos por estado</h2><p class="small text-muted">Incluye cancelados para mostrar la distribución operativa.</p><partial name="_Chart" model="Model.OrdersByStatus" /></div></section>
    <section class="col-lg-6"><div class="card-admin p-3 h-100"><h2 class="h5">Venta bruta por categoría</h2><p class="small text-muted">Precio por cantidad; antes de descuentos y envío. Categoría actual del producto.</p><partial name="_Chart" model="Model.SalesByCategory" /></div></section>
    <section class="col-lg-6"><div class="card-admin p-3 h-100"><h2 class="h5">Importe por método de pago</h2><partial name="_Chart" model="Model.SalesByPayment" /></div></section>
</div>
<section class="card-admin p-3 mb-4"><h2 class="h5">Productos más vendidos del periodo</h2>
    <partial name="_Chart" model="@(Model.TopProducts.Select(p => new ChartPoint { Label = p.Name, Value = p.QuantitySold }).ToList())" />
    <p class="small text-muted mb-0">Unidades de pedidos no cancelados.</p>
</section>
@if (canViewOrders)
{
<section class="card-admin p-3"><h2 class="h5">Pedidos recientes del rango</h2>
    <form method="get" class="d-flex flex-wrap gap-2 my-3">
        <input type="hidden" name="from" value="@Model.From.ToString("yyyy-MM-dd")" /><input type="hidden" name="to" value="@Model.To.ToString("yyyy-MM-dd")" /><input type="hidden" name="interval" value="@Model.Interval" />
        <label for="recentStatus" class="form-label">Estado</label><select class="form-select w-auto" id="recentStatus" name="status"><option value="">Todos</option>@foreach(var status in Enum.GetValues<OrderStatus>()) { <option value="@status" selected="@(Model.RecentStatus == status)">@status.GetLabel()</option> }</select><button class="btn btn-outline-dark">Filtrar pedidos</button>
    </form>
    @if (Model.RecentOrders.Count == 0) { <p>No hay pedidos en este rango.</p> }
    else { <div class="table-responsive"><table class="table table-admin"><thead><tr><th>Pedido</th><th>Cliente</th><th>Producto principal</th><th>Fecha local</th><th>Importe</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
    @foreach (var order in Model.RecentOrders) {
        <tr><td>@order.OrderNumber</td><td>@order.CustomerName</td><td>@order.MainProductName</td><td>@SalesCriteria.Local(order.CreatedAt).ToString("dd/MM HH:mm")</td><td>@order.Total.ToString("C")</td><td><span class="badge badge-status bg-secondary">@order.StatusLabel</span></td><td>
        <a asp-controller="Orders" asp-action="Details" asp-route-orderNumber="@order.OrderNumber">Ver pedido</a>
        @if (canUpdateOrders)
        {
        <form asp-controller="Orders" asp-action="UpdateStatus" method="post" class="d-flex gap-2 mt-2">
            <input type="hidden" name="orderNumber" value="@order.OrderNumber" />
            <label class="visually-hidden" for="status-@order.Id">Nuevo estado de @order.OrderNumber</label>
            <select id="status-@order.Id" name="status" class="form-select form-select-sm">
            @foreach (var next in Enum.GetValues<OrderStatus>().Where(s => OrderTransitions.Allows(order.Status, s, order.PaymentStatus))) { <option value="@next" selected="@(next == order.Status)">@next.GetLabel()</option> }
            </select><button class="btn btn-sm btn-outline-dark">Guardar</button>
        </form>
        }
        </td></tr>
    }
    </tbody></table></div> }
</section>

}
