@model IReadOnlyList<CategoryDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="admin-title mb-0">Categorías</h1>
    <a class="btn btn-gold" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Nueva categoría</a>
</div>

<div class="card-admin">
    <div class="table-responsive">
        <table class="table table-admin mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Slug</th>
                    <th class="text-center">Orden</th>
                    <th class="text-center">Productos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td><strong>@category.Name</strong></td>
                        <td class="text-muted">@category.Slug</td>
                        <td class="text-center">@category.DisplayOrder</td>
                        <td class="text-center">@category.ProductCount</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@category.Id" title="Editar"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="m-0" onsubmit="return confirm('¿Eliminar esta categoría?');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
