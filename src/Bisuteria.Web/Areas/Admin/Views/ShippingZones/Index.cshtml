@model IReadOnlyList<Bisuteria.Domain.Entities.DeliveryZone>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="admin-title mb-1">Zonas y tarifas</h1>
        <p class="text-muted mb-0">Cobertura en Manta y Jaramijó, Manabí. Cada sector tiene su propia tarifa.</p>
    </div>
    <a class="btn btn-gold" asp-action="Create"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nueva zona</a>
</div>

<div class="card-admin">
    <div class="table-responsive" role="region" aria-label="Zonas y tarifas de envío" tabindex="0">
        <table class="table table-admin align-middle mb-0">
            <thead><tr><th>Ciudad y sector</th><th>Tarifa</th><th>Tiempo estimado</th><th>Orden</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Todavía no hay zonas configuradas. Crea una zona para habilitar sus sectores en el checkout.</td></tr>
            }
            @foreach (var zone in Model)
            {
                <tr>
                    <td><strong class="d-block">@zone.Sector</strong><span class="text-muted small">@zone.City, @zone.Province</span></td>
                    <td>@(zone.RequiresConfirmation ? "Por confirmar" : zone.IsFree ? "Envío gratis" : zone.Cost.ToString("C"))</td>
                    <td>@(string.IsNullOrWhiteSpace(zone.EstimatedTime) ? "Sin plazo configurado" : zone.EstimatedTime)</td>
                    <td>@zone.SortOrder</td>
                    <td><span class="badge @(zone.IsActive ? "bg-success" : "bg-secondary")">@(zone.IsActive ? "Activa" : "Inactiva")</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@zone.Id" aria-label="Editar la zona @zone.Sector de @zone.City"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Editar</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="small text-muted mt-3">Para retirar una zona del checkout, edítala y desmarca «Zona activa». Los pedidos anteriores mantienen su destino y tarifa.</p>
