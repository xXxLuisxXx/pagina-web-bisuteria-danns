@inject Microsoft.AspNetCore.Identity.UserManager<Bisuteria.Infrastructure.Identity.ApplicationUser> UserManager
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser != null ? $"{currentUser.FirstName} {currentUser.LastName}" : "Administrador";
    var currentRoles = currentUser is null ? Array.Empty<string>() : (await UserManager.GetRolesAsync(currentUser)).ToArray();
    string RoleLabel(string role) => role switch { "Developer" => "Desarrollador", "Owner" => "Propietaria", "Operator" => "Operador", "Customer" => "Cliente", _ => "Administración" };
    async Task<bool> Allowed(string permission) => (await Authorization.AuthorizeAsync(User, null, permission)).Succeeded;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Dann's Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">

    <header class="admin-topbar">
        <button class="btn btn-outline-light d-lg-none" type="button" id="adminMenuToggle" aria-label="Abrir o cerrar administración" aria-controls="adminSidebar" aria-expanded="false">
            <i class="bi bi-list"></i>
        </button>
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-gem me-2"></i>Dann's Bisutería</a>
        <strong class="admin-page-title">@ViewData["Title"]</strong>
        @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.AdminSearch))
        {
        <form asp-area="Admin" asp-controller="Search" asp-action="Index" method="get" class="admin-search" role="search"><label for="admin-search" class="visually-hidden">Buscar pedidos o productos</label><i class="bi bi-search" aria-hidden="true"></i><input id="admin-search" name="q" maxlength="200" placeholder="Buscar pedidos, clientes, productos o SKU…" /><button class="visually-hidden-focusable" type="submit">Buscar</button></form>
        }
        @await Component.InvokeAsync("AdminNotifications")
        <button type="button" class="btn btn-outline-light btn-sm" id="adminTheme" aria-label="Cambiar modo oscuro" aria-pressed="false"><i class="bi bi-moon" aria-hidden="true"></i></button>
        <details class="admin-profile"><summary aria-label="Menú del perfil"><i class="bi bi-person-circle" aria-hidden="true"></i></summary><div class="admin-popover"><strong>@displayName</strong><span class="badge text-bg-secondary">@string.Join(", ", currentRoles.Select(RoleLabel))</span><a href="/Account/Profile">Mi perfil</a><a href="/Account/Authenticator">Seguridad en dos pasos</a></div></details>
        <a class="btn btn-outline-light btn-sm" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-shop me-1"></i>Ver tienda</a>
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-light btn-sm" type="submit"><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span class="visually-hidden">Cerrar sesión</span></button>
        </form>
    </header>

    <nav class="admin-sidebar" id="adminSidebar" aria-label="Administración"><a href="/Admin" class="sidebar-brand"><img src="/img/logo-mark.svg" alt="" /><strong>DANN’S<small>Bisutería y accesorios</small></strong></a>
        <div class="nav flex-column gap-1">
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.DashboardView)) { <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i>Panel de administración</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.DashboardView)) { <a class="nav-link" asp-area="Admin" asp-controller="Activity" asp-action="Index"><i class="bi bi-clock-history"></i>Mi actividad</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.ProductsManage)) { <a class="nav-link" asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i>Productos</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.CategoriesManage)) { <a class="nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i>Categorías</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.OrdersView)) { <a class="nav-link" asp-area="Admin" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt"></i>Pedidos</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.CustomersViewLimited)) { <a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i>Usuarios</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.ReviewsModerate)) { <a class="nav-link" asp-area="Admin" asp-controller="Reviews" asp-action="Index"><i class="bi bi-star"></i>Reseñas</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.MessagesView)) { <a class="nav-link" asp-area="Admin" asp-controller="Messages" asp-action="Index"><i class="bi bi-envelope"></i>Mensajes</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.CouponsManage)) { <a class="nav-link" asp-area="Admin" asp-controller="Coupons" asp-action="Index"><i class="bi bi-ticket-perforated"></i>Cupones</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.BlogManage)) { <a class="nav-link" asp-area="Admin" asp-controller="Blog" asp-action="Index"><i class="bi bi-journal-text"></i>Blog</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.GalleryManage)) { <a class="nav-link" asp-area="Admin" asp-controller="Gallery" asp-action="Index"><i class="bi bi-images"></i>Galería</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.InventoryAdjust)) { <a class="nav-link" asp-area="Admin" asp-controller="Inventory" asp-action="Index"><i class="bi bi-clipboard-data"></i>Inventario</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.ReportsView)) { <a class="nav-link" asp-area="Admin" asp-controller="Reports" asp-action="Index"><i class="bi bi-graph-up"></i>Reportes</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.StoreSettingsEdit)) { <a class="nav-link" asp-area="Admin" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i>Configuración</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.UsersManageStaff) || await Allowed(Bisuteria.Domain.Security.StorePermissions.UsersManageOwner)) { <a class="nav-link" asp-area="" asp-controller="StaffInvitation" asp-action="Index"><i class="bi bi-person-plus"></i>Invitaciones de equipo</a> }
            @if (await Allowed(Bisuteria.Domain.Security.StorePermissions.RolesViewMatrix)) { <a class="nav-link" asp-area="Developer" asp-controller="Roles" asp-action="Index"><i class="bi bi-shield-lock"></i>Modo desarrollador</a> }
        </div>
        <a href="/" class="sidebar-store"><i class="bi bi-shop" aria-hidden="true"></i><strong>Tu tienda, siempre cerca</strong><span>Ver tienda ↗</span></a>
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-dark w-100" type="submit"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Cerrar sesión</button></form>
    </nav>

    <main class="admin-content" id="admin-main"><div class="admin-loading" role="status" hidden>Cargando…<span></span><span></span><span></span></div>
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>@error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @RenderBody()
    </main>

    <script nonce="@Context.Items["CspNonce"]" src="~/lib/jquery/dist/jquery.min.js"></script>
    <script nonce="@Context.Items["CspNonce"]" src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script nonce="@Context.Items["CspNonce"]" src="~/js/site.js" asp-append-version="true"></script>
    <script nonce="@Context.Items["CspNonce"]" src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
