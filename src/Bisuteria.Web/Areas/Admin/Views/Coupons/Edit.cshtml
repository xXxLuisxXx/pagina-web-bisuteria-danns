@model CouponInputDto

<div class="mb-4">
    <a class="text-muted small text-decoration-none" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Volver a cupones</a>
    <h1 class="admin-title mt-2 mb-0">@(Model.Id == 0 ? "Nuevo cupón" : "Editar cupón")</h1>
</div>

<div class="card-admin p-3 admin-form-width-wide">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" role="alert" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" placeholder="Ej: BIENVENIDA10" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Description" class="form-label">Descripción</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Type" class="form-label">Tipo</label>
                <select asp-for="Type" class="form-select">
                    <option value="Percentage">Porcentaje (%)</option>
                    <option value="FixedAmount">Monto fijo ($)</option>
                </select>
                <span asp-validation-for="Type" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Value" class="form-label">Valor</label>
                <input asp-for="Value" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Value" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="MinAmount" class="form-label">Compra mínima ($)</label>
                <input asp-for="MinAmount" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="MinAmount" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="MaxUses" class="form-label">Máximo de usos (vacío = ilimitado)</label>
                <input asp-for="MaxUses" class="form-control" type="number" min="1" />
                <span asp-validation-for="MaxUses" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="StartsAt" class="form-label">Fecha de inicio</label>
                <input asp-for="StartsAt" class="form-control" type="date" min="2000-01-01" max="2100-12-31" />
                <span asp-validation-for="StartsAt" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ExpiresAt" class="form-label">Fecha de expiración</label>
                <input asp-for="ExpiresAt" class="form-control" type="date" min="2000-01-01" max="2100-12-31" />
                <span asp-validation-for="ExpiresAt" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Cupón activo</label>
                </div>
            </div>
        </div>
        <button class="btn btn-gold mt-3" type="submit"><i class="bi bi-check2 me-2"></i>Guardar</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
