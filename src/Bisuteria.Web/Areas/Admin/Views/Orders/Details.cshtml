@model OrderDto

<div class="mb-4">
    <a class="text-muted small text-decoration-none" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Volver a pedidos</a>
    <h1 class="admin-title mt-2 mb-0">Pedido @Model.OrderNumber</h1>
    <p class="text-muted mb-0">Realizado el @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card-admin p-3 mb-3">
            <h6 class="fw-semibold mb-3"><i class="bi bi-box-seam me-2 text-gold"></i>Artículos</h6>
            <table class="table table-admin mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="text-center">Cant.</th>
                        <th class="text-end">Precio</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img class="product-mini-img" src="@(item.ImageUrl ?? "/img/placeholder.svg")" alt="@item.ProductName" />
                                    <div>
                                        <strong>@item.ProductName</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.CustomizationSummary))
                                        {
                                            <div class="small text-gold"><i class="bi bi-magic me-1"></i>@item.CustomizationSummary</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice.ToString("C")</td>
                            <td class="text-end fw-semibold">@item.LineTotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <hr>
            <div class="d-flex justify-content-between mb-1"><span>Subtotal</span><strong>@Model.Subtotal.ToString("C")</strong></div>
            @if (Model.Discount > 0)
            {
                <div class="d-flex justify-content-between mb-1 text-success"><span>Descuento</span><strong>-@Model.Discount.ToString("C")</strong></div>
            }
            <div class="d-flex justify-content-between mb-1"><span>Envío</span><strong>@(Model.ShippingCost == 0 ? "Gratis" : Model.ShippingCost.ToString("C"))</strong></div>
            <hr>
            <div class="d-flex justify-content-between fs-5"><span>Total</span><strong class="text-gold">@Model.Total.ToString("C")</strong></div>
        </div>

        <div class="card-admin p-3 mb-3">
            <h6 class="fw-semibold mb-3"><i class="bi bi-geo-alt me-2 text-gold"></i>Datos del cliente</h6>
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-1"><strong>Nombre:</strong> @Model.CustomerName</p>
                    <p class="mb-1"><strong>Correo:</strong> @Model.CustomerEmail</p>
                    <p class="mb-1"><strong>Teléfono:</strong> @Model.CustomerPhone</p>
                    <p class="mb-1"><strong>Entrega:</strong> @Model.DeliveryMethodLabel</p>
                </div>
                <div class="col-md-6">
                    @if (Model.DeliveryMethod == Bisuteria.Domain.Enums.DeliveryMethod.Shipping)
                    {
                        <p class="mb-1"><strong>Envío:</strong> @Model.AddressLine1</p>
                        @if (!string.IsNullOrWhiteSpace(Model.AddressLine2))
                        {
                            <p class="mb-1"><strong>Dirección complementaria:</strong> @Model.AddressLine2</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.PostalCode))
                        {
                            <p class="mb-1"><strong>Código postal:</strong> @Model.PostalCode</p>
                        }
                        <p class="mb-1"><strong>Ciudad:</strong> @Model.City, @Model.Province</p>
                    }
                    else
                    {
                        <p class="mb-1"><strong>Entrega coordinada en:</strong> @Model.City, @Model.Province</p>
                    }
                    @if (Model.IsGift)
                    {
                        <p class="mb-1"><strong><i class="bi bi-gift me-1 text-warning"></i>Regalo:</strong> @(Model.GiftRecipientName ?? "Sí")</p>
                        @if (!string.IsNullOrWhiteSpace(Model.GiftMessage))
                        {
                            <p class="mb-1 fst-italic">"@Model.GiftMessage"</p>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Observations))
                    {
                        <p class="mb-1"><strong>Observaciones:</strong> @Model.Observations</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card-admin p-3 mb-3">
            <h6 class="fw-semibold mb-3"><i class="bi bi-arrow-repeat me-2 text-gold"></i>Estado del pedido</h6>
            <form asp-action="UpdateStatus" method="post" class="d-flex flex-column gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderNumber" value="@Model.OrderNumber" />
                <select name="status" class="form-select">
                    @foreach (var status in (OrderStatus[])ViewBag.Statuses)
                    {
                        <option value="@status" selected="@(status == Model.Status)">@status.GetLabel()</option>
                    }
                </select>
                <input type="text" name="adminNotes" class="form-control" placeholder="Nota interna (opcional)" maxlength="2000" value="@ViewBag.AdminNotes" />
                <button class="btn btn-gold" type="submit"><i class="bi bi-check2 me-2"></i>Actualizar estado</button>
            </form>
        </div>

        <div class="card-admin p-3 mb-3">
            <h6 class="fw-semibold mb-3"><i class="bi bi-credit-card me-2 text-gold"></i>Pago</h6>
            <p class="mb-2"><strong>Método:</strong> @Model.PaymentMethodLabel</p>
            <p class="small text-muted">Marca «Reembolsado» únicamente después de devolver el dinero por el medio acordado. Esta acción no realiza una devolución bancaria.</p>
            <form asp-action="UpdatePayment" method="post" class="d-flex flex-column gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderNumber" value="@Model.OrderNumber" />
                <select name="status" class="form-select">
                    @foreach (var status in (PaymentStatus[])ViewBag.PaymentStatuses)
                    {
                        <option value="@status" selected="@(status == Model.PaymentStatus)">@status.GetLabel()</option>
                    }
                </select>
                <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-arrow-repeat me-2"></i>Actualizar pago</button>
            </form>
        </div>
    </div>
</div>
