@model OrderDto
@using Bisuteria.Application.Services
@using Bisuteria.Web.Models

<div class="mb-4">
    <a class="text-muted small text-decoration-none" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Volver a pedidos</a>
    <h1 class="admin-title text-break mt-2 mb-0">Pedido @Model.OrderNumber</h1>
    <p class="text-muted mb-0">Realizado el @SalesCriteria.Local(Model.CreatedAt).ToString("dd MMM yyyy HH:mm")</p>
</div>

<section class="card-admin p-3 mb-3" aria-labelledby="timeline-title">
    <h2 id="timeline-title" class="h6">Historial del pedido</h2>
    <p>Estado actual: <span class="badge @Model.Status.GetBadgeClass()">@Model.StatusLabel</span></p>
    <ol class="mb-0">
        @foreach (var entry in (IReadOnlyList<OrderTimelineEntry>)ViewBag.Timeline)
        {
            <li><time datetime="@entry.AtUtc.ToString("O")">@SalesCriteria.Local(entry.AtUtc).ToString("dd MMM yyyy HH:mm")</time> · @entry.Label</li>
        }
    </ol>
    <p class="small text-muted mb-0 mt-2">Solo se muestran sucesos con fecha registrada. Los estados históricos sin registro no se reconstruyen.</p>
</section>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card-admin p-3 mb-3">
            <h6 class="fw-semibold mb-3"><i class="bi bi-box-seam me-2 text-gold"></i>Artículos</h6>
            <div class="table-responsive" role="region" aria-label="Artículos del pedido" tabindex="0">
            <table class="table table-admin mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="text-center">Cant.</th>
                        <th class="text-end">Precio</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img class="product-mini-img" src="@(item.ImageUrl ?? "/img/placeholder.svg")" alt="@item.ProductName" />
                                    <div>
                                        <strong>@item.ProductName</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.CustomizationSummary))
                                        {
                                            <div class="small text-gold"><i class="bi bi-magic me-1"></i>@item.CustomizationSummary</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice.ToString("C")</td>
                            <td class="text-end fw-semibold">@item.LineTotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <hr>
            <div class="d-flex justify-content-between mb-1"><span>Subtotal</span><strong>@Model.Subtotal.ToString("C")</strong></div>
            @if (Model.Discount > 0)
            {
                <div class="d-flex justify-content-between mb-1 text-success"><span>Descuento</span><strong>-@Model.Discount.ToString("C")</strong></div>
            }
            <div class="d-flex justify-content-between mb-1"><span>Envío</span><strong>@(Model.ShippingToConfirm ? "Por confirmar" : Model.ShippingCost.ToString("C"))</strong></div>
            <hr>
            <div class="d-flex justify-content-between fs-5"><span>Total</span><strong class="text-gold">@Model.Total.ToString("C")</strong></div>
        </div>

        <div class="card-admin p-3 mb-3">
            <h6 class="fw-semibold mb-3"><i class="bi bi-geo-alt me-2 text-gold"></i>Datos del cliente</h6>
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-1"><strong>Nombre:</strong> @Model.CustomerName</p>
                    <p class="mb-1"><strong>Correo:</strong> @Model.CustomerEmail</p>
                    <p class="mb-1"><strong>Teléfono:</strong> @Model.CustomerPhone</p>
                    <p class="mb-1"><strong>Entrega:</strong> @Model.DeliveryMethodLabel</p>
                </div>
                <div class="col-md-6">
                    @if (Model.DeliveryMethod == Bisuteria.Domain.Enums.DeliveryMethod.Shipping)
                    {
                        <p class="mb-1"><strong>Envío:</strong> @Model.AddressLine1</p>
                        @if (!string.IsNullOrWhiteSpace(Model.AddressLine2))
                        {
                            <p class="mb-1"><strong>Dirección complementaria:</strong> @Model.AddressLine2</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.PostalCode))
                        {
                            <p class="mb-1"><strong>Código postal:</strong> @Model.PostalCode</p>
                        }
                        <p class="mb-1"><strong>Ciudad:</strong> @Model.City, @Model.Province</p>
                    }
                    else
                    {
                        <p class="mb-1"><strong>Entrega coordinada en:</strong> @Model.City, @Model.Province</p>
                    }
                    @if (Model.IsGift)
                    {
                        <p class="mb-1"><strong><i class="bi bi-gift me-1 text-warning"></i>Regalo:</strong> @(Model.GiftRecipientName ?? "Sí")</p>
                        @if (!string.IsNullOrWhiteSpace(Model.GiftMessage))
                        {
                            <p class="mb-1 fst-italic">"@Model.GiftMessage"</p>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Observations))
                    {
                        <p class="mb-1"><strong>Observaciones:</strong> @Model.Observations</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card-admin p-3 mb-3">
            <h6 class="fw-semibold mb-3"><i class="bi bi-arrow-repeat me-2 text-gold"></i>Estado del pedido</h6>
            @if (ViewBag.CanUpdateStatus is true)
            {
            <form asp-action="UpdateStatus" method="post" class="d-flex flex-column gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderNumber" value="@Model.OrderNumber" />
                <label class="form-label" for="orderStatus">Nuevo estado</label>
                <select id="orderStatus" name="status" class="form-select">
                    @foreach (var status in (OrderStatus[])ViewBag.Statuses)
                    {
                        <option value="@status" selected="@(status == Model.Status)">@status.GetLabel()</option>
                    }
                </select>
                <input type="text" name="adminNotes" class="form-control" placeholder="Nota interna (opcional)" maxlength="2000" value="@ViewBag.AdminNotes" />
                <button class="btn btn-gold" type="submit"><i class="bi bi-check2 me-2"></i>Actualizar estado</button>
            </form>
            }
            else { <p class="mb-0">@Model.StatusLabel</p> }
        </div>

        <div class="card-admin p-3 mb-3">
            @if (ViewBag.CanViewProof is true && ViewBag.PaymentProofs is IReadOnlyList<PaymentProofDto> proofs && proofs.Count > 0)
            {
                <h6 class="fw-semibold mb-3"><i class="bi bi-receipt me-2 text-gold"></i>Comprobantes de transferencia</h6>
                @foreach (var proof in proofs)
                {
                    <div class="border rounded p-2 mb-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>@SalesCriteria.Local(proof.CreatedAt).ToString("dd MMM yyyy HH:mm") · @(proof.ContentType == "application/pdf" ? "PDF" : "Imagen") · @((proof.Length / 1024.0).ToString("0")) KB</span>
                            @if (ViewBag.CanViewProof is true) { <a class="btn btn-sm btn-outline-secondary" asp-action="Proof" asp-route-id="@proof.Id" target="_blank" rel="noopener">Ver archivo</a> }
                        </div>
                        <div class="small">Estado: @(proof.Status == PaymentProofStatus.Pending ? "Pendiente de revisión" : proof.Status == PaymentProofStatus.Approved ? "Aprobado" : "Rechazado")</div>
                        @if (proof.Status == PaymentProofStatus.Pending && ViewBag.CanReviewProof is true)
                        {
                            <form asp-action="ReviewProof" method="post" class="mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@proof.Id" />
                                <label class="form-label small" for="proof-note-@proof.Id">Motivo si se rechaza</label>
                                <input id="proof-note-@proof.Id" name="note" class="form-control form-control-sm mb-2" maxlength="500" />
                                <button class="btn btn-sm btn-success" name="approve" value="true" type="submit">Aprobar y registrar pago</button>
                                <button class="btn btn-sm btn-outline-danger" name="approve" value="false" type="submit">Rechazar</button>
                            </form>
                        }
                        @if (!string.IsNullOrWhiteSpace(proof.ReviewNote)) { <p class="small text-muted mb-0">@proof.ReviewNote</p> }
                    </div>
                }
            }
            @if (ViewBag.CanEditShipping is true)
            {
                <h6 class="fw-semibold mb-2"><i class="bi bi-truck me-2 text-gold"></i>@(Model.ShippingToConfirm ? "Confirmar recargo de envío" : "Actualizar recargo de envío")</h6>
                <p class="small text-muted">Revisa ciudad y dirección; registra el monto acordado en USD. El cliente recibirá el total actualizado.</p>
                <form asp-action="ConfirmShipping" method="post" class="d-flex flex-column gap-2 mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderNumber" value="@Model.OrderNumber" />
                    <label for="shippingCost" class="form-label">Recargo (USD)</label>
                    <input id="shippingCost" name="shippingCost" type="number" class="form-control" min="0" max="10000" step="0.01" required />
                    <button class="btn btn-gold" type="submit">Confirmar envío y total</button>
                </form>
            }
            <h6 class="fw-semibold mb-3"><i class="bi bi-credit-card me-2 text-gold"></i>Pago</h6>
            <p class="mb-2"><strong>Método:</strong> @Model.PaymentMethodLabel</p>
            <p class="mb-2"><strong>Estado:</strong> @Model.PaymentStatus.GetLabel()</p>
            @if (ViewBag.CanUpdatePayment is true)
            {
            <p class="small text-muted">Marca «Reembolsado» únicamente después de devolver el dinero por el medio acordado. Esta acción no realiza una devolución bancaria.</p>
            <form asp-action="UpdatePayment" method="post" class="d-flex flex-column gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderNumber" value="@Model.OrderNumber" />
                <label class="form-label" for="paymentStatus">Estado del pago</label>
                <select id="paymentStatus" name="status" class="form-select">
                    @foreach (var status in (PaymentStatus[])ViewBag.PaymentStatuses)
                    {
                        <option value="@status" selected="@(status == Model.PaymentStatus)">@status.GetLabel()</option>
                    }
                </select>
                <button class="btn btn-outline-secondary" type="submit" disabled="@Model.ShippingToConfirm"><i class="bi bi-arrow-repeat me-2"></i>Actualizar pago</button>
            </form>
            }
        </div>
    </div>
</div>
