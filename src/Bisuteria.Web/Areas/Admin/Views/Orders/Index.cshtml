@model PaginatedOrdersResult

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="admin-title mb-0">Pedidos</h1>
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="hidden" name="attention" value="@ViewBag.Attention" />
        <label class="visually-hidden" for="order-search">Buscar pedidos</label>
        <input id="order-search" type="search" name="search" class="form-control" placeholder="Número, cliente o correo..." value="@ViewBag.Search" />
        <button class="btn btn-outline-secondary" type="submit" aria-label="Buscar pedidos"><i class="bi bi-search" aria-hidden="true"></i></button>
    </form>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-sm @(ViewBag.Status == null ? "btn-gold" : "btn-outline-secondary")" asp-action="Index">Todos (@Model.TotalCount)</a>
    @foreach (var status in Enum.GetValues<OrderStatus>())
    {
        var count = ((Dictionary<OrderStatus, int>)ViewBag.StatusCounts).GetValueOrDefault(status);
        <a class="btn btn-sm @((OrderStatus?)ViewBag.Status == status ? "btn-gold" : "btn-outline-secondary")"
           asp-action="Index" asp-route-status="@status">@status.GetLabel() (@count)</a>
    }
</div>

@if (ViewBag.AttentionLabel is string attentionLabel)
{
    <p class="alert alert-info" role="status">@attentionLabel. <a asp-action="Index">Quitar filtro de atención</a></p>
}
<div class="card-admin">
    <div class="table-responsive" tabindex="0" role="region" aria-label="Tabla de pedidos; desplázate horizontalmente para ver todas las columnas">
        <table class="table table-admin mb-0">
            <thead>
                <tr>
                    <th>Pedido</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th class="text-center">Pago</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Items)
                {
                    <tr>
                        <td><strong>@order.OrderNumber</strong></td>
                        <td>@order.CustomerName<br><small class="text-muted">@order.CustomerEmail</small></td>
                        <td>@order.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        <td class="text-center">
                            <span class="badge badge-status @(order.PaymentStatus == PaymentStatus.Paid ? "bg-success" : order.PaymentStatus == PaymentStatus.Failed ? "bg-danger" : order.PaymentStatus == PaymentStatus.PartiallyPaid ? "bg-info text-dark" : "bg-warning text-dark")">@order.PaymentStatus.GetLabel()</span>
                        </td>
                        <td class="text-center">
                            <span class="badge badge-status @order.Status.GetBadgeClass()">@order.StatusLabel</span>
                        </td>
                        <td class="text-end fw-semibold text-gold">@order.Total.ToString("C")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-orderNumber="@order.OrderNumber"><i class="bi bi-eye"></i> Ver</a>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay pedidos.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page > 1 ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-status="@ViewBag.Status" asp-route-search="@ViewBag.Search" asp-route-attention="@ViewBag.Attention"><i class="bi bi-chevron-left"></i></a>
            </li>
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-status="@ViewBag.Status" asp-route-search="@ViewBag.Search" asp-route-attention="@ViewBag.Attention">@i</a>
                </li>
            }
            <li class="page-item @(Model.Page < Model.TotalPages ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-status="@ViewBag.Status" asp-route-search="@ViewBag.Search" asp-route-attention="@ViewBag.Attention"><i class="bi bi-chevron-right"></i></a>
            </li>
        </ul>
    </nav>
}
