@model ProductInputDto

<div class="mb-4">
    <a class="text-muted small text-decoration-none" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Volver a productos</a>
    <h1 class="admin-title mt-2 mb-0">@(Model.Id == 0 ? "Nuevo producto" : "Editar producto")</h1>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="OriginalStock" />
    <div asp-validation-summary="All" role="alert" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card-admin p-3 mb-3">
                <h6 class="fw-semibold mb-3">Información general</h6>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CategoryId" class="form-label">Categoría</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Sku" class="form-label">SKU</label>
                        <input asp-for="Sku" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Stock" class="form-label">Stock</label>
                        <input asp-for="Stock" class="form-control" type="number" min="0" />
                    </div>
                </div>
            </div>

            <div class="card-admin p-3 mb-3">
                <h6 class="fw-semibold mb-3">Precios</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Price" class="form-label">Precio (USD)</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ComparePrice" class="form-label">Precio tachado (opcional)</label>
                        <input asp-for="ComparePrice" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MinStock" class="form-label">Stock mínimo</label>
                        <input asp-for="MinStock" class="form-control" type="number" min="0" />
                    </div>
                </div>
            </div>

            <div class="card-admin p-3 mb-3">
                <h6 class="fw-semibold mb-3">Detalles del producto</h6>
                <div class="row g-2 mb-3">
                @foreach (var image in Model.Images)
                {
                    <div class="col-6 col-md-4"><img src="@image.ImageUrl" alt="Imagen del producto" class="img-fluid" loading="lazy" />
                    <label><input type="checkbox" name="RemoveImageIds" value="@image.Id" /> Eliminar imagen</label></div>
                }
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Material" class="form-label">Material</label>
                        <input asp-for="Material" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Colors" class="form-label">Colores</label>
                        <input asp-for="Colors" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Size" class="form-label">Tamaño</label>
                        <input asp-for="Size" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Subir imágenes desde tu dispositivo</label>
                        <input type="file" name="imageFiles" class="form-control" multiple
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        <div class="form-text">
                            JPG, PNG o WebP · máx. 8 MB por archivo. Se optimizan automáticamente (máx. 1200 px, compresión automática).
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Imágenes adicionales (URLs, una por línea)</label>
                        <textarea name="newImages" class="form-control" rows="3" placeholder="/img/uploads/products/foto1.jpg"></textarea>
                        <div class="form-text">Usa rutas locales que empiecen por /img/. La primera imagen será la principal.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card-admin p-3 mb-3">
                <h6 class="fw-semibold mb-3">Estado y visibilidad</h6>
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Producto activo</label>
                </div>
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsFeatured" class="form-check-input" />
                    <label asp-for="IsFeatured" class="form-check-label">Destacado en inicio</label>
                </div>
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsNew" class="form-check-input" />
                    <label asp-for="IsNew" class="form-check-label">Marcar como nuevo</label>
                </div>
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsCustomizable" class="form-check-input" />
                    <label asp-for="IsCustomizable" class="form-check-label">Personalizable</label>
                </div>
            </div>
            <button class="btn btn-gold w-100 btn-lg" type="submit"><i class="bi bi-check2 me-2"></i>Guardar producto</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
