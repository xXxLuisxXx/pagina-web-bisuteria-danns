@model PaginatedResult<ProductCardDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="admin-title mb-0">Productos</h1>
    <a class="btn btn-gold" asp-action="Edit"><i class="bi bi-plus-lg me-1"></i>Nuevo producto</a>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width:420px;">
        <input type="search" name="search" class="form-control" placeholder="Buscar por nombre o SKU..." value="@ViewBag.Search" />
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
    </div>
</form>

<div class="card-admin">
    <div class="table-responsive">
        <table class="table table-admin mb-0">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>ID</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th class="text-center">Stock</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img class="product-mini-img" src="@(product.MainImageUrl ?? "/img/placeholder.svg")" alt="@product.Name" />
                                <div>
                                    <strong>@product.Name</strong>
                                    <div class="small text-muted">@product.SoldCount vendidos</div>
                                </div>
                            </div>
                        </td>
                        <td class="text-muted">@($"#{product.Id:D4}")</td>
                        <td>@product.CategoryName</td>
                        <td class="text-end">
                            @if (product.ComparePrice.HasValue && product.ComparePrice > product.EffectivePrice)
                            {
                                <div class="small text-muted text-decoration-line-through">@product.ComparePrice.Value.ToString("C")</div>
                            }
                            <strong class="text-gold">@product.EffectivePrice.ToString("C")</strong>
                        </td>
                        <td class="text-center">
                            @if (product.Stock <= 0)
                            {
                                <span class="badge badge-status bg-danger">Agotado</span>
                            }
                            else if (product.Stock <= 5)
                            {
                                <span class="badge badge-status bg-warning text-dark">@product.Stock</span>
                            }
                            else
                            {
                                <span class="badge badge-status bg-success">@product.Stock</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (product.IsActive)
                            {
                                <span class="badge badge-status bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge badge-status bg-secondary">Inactivo</span>
                            }
                            @if (product.IsFeatured)
                            {
                                <span class="badge badge-status bg-gold text-white ms-1">★</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@product.Id" title="Editar"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="m-0" onsubmit="return confirm('¿Eliminar este producto?');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay productos.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@ViewBag.Search"><i class="bi bi-chevron-left"></i></a>
            </li>
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@ViewBag.Search"><i class="bi bi-chevron-right"></i></a>
            </li>
        </ul>
    </nav>
}
