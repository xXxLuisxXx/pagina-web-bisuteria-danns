@model PaginatedBlogResult

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="admin-title mb-0">Blog</h1>
    <a class="btn btn-gold" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Nueva publicación</a>
</div>

<div class="card-admin">
    <div class="table-responsive">
        <table class="table table-admin mb-0">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Autor</th>
                    <th class="text-center">Vistas</th>
                    <th>Publicado</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model.Items)
                {
                    <tr>
                        <td><strong>@post.Title</strong></td>
                        <td>@post.Author</td>
                        <td class="text-center">@post.Views</td>
                        <td>@(post.PublishedAt.HasValue ? post.PublishedAt.Value.ToString("dd MMM yyyy") : "—")</td>
                        <td class="text-center">
                            @if (post.PublishedAt.HasValue)
                            {
                                <span class="badge badge-status bg-success">Publicado</span>
                            }
                            else
                            {
                                <span class="badge badge-status bg-secondary">Borrador</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@post.Id" title="Editar"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@post.Id" method="post" class="m-0" data-confirm="¿Eliminar esta publicación?">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page > 1 ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)"><i class="bi bi-chevron-left"></i></a>
            </li>
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.Page < Model.TotalPages ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)"><i class="bi bi-chevron-right"></i></a>
            </li>
        </ul>
    </nav>
}
