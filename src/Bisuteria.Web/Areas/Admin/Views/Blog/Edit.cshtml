@model BlogPostInputDto

<div class="mb-4">
    <a class="text-muted small text-decoration-none" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Volver al blog</a>
    <h1 class="admin-title mt-2 mb-0">@(Model.Id == 0 ? "Nueva publicación" : "Editar publicación")</h1>
</div>

<div class="card-admin p-3">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" role="alert" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Author" class="form-label">Autor</label>
                <input asp-for="Author" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Excerpt" class="form-label">Extracto</label>
                <textarea asp-for="Excerpt" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-12">
                <label asp-for="Content" class="form-label">Contenido</label>
                <textarea asp-for="Content" class="form-control" rows="10"></textarea>
                <div class="form-text">Escribe texto simple. Los saltos de línea se conservarán al publicar.</div>
            </div>
            <div class="col-md-8">
                <label asp-for="Tags" class="form-label">Etiquetas (separadas por coma)</label>
                <input asp-for="Tags" class="form-control" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsPublished" class="form-check-input" />
                    <label asp-for="IsPublished" class="form-check-label">Publicar</label>
                </div>
            </div>
        </div>
        <button class="btn btn-gold mt-3" type="submit"><i class="bi bi-check2 me-2"></i>Guardar</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
